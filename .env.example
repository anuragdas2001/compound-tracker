# Database Configuration (MongoDB)
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/compound?retryWrites=true&w=majority"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-super-secret-nextauth-token"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Resend Email Service Configuration
# Get your API key at https://resend.com
RESEND_API_KEY=""
# Default verified sender address, e.g. "Habitly <onboarding@resend.dev>" or "Habitly <noreply@yourdomain.com>"
RESEND_FROM_EMAIL="Habitly <onboarding@resend.dev>"

# API Backend Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000"


# Razorpay Payment Gateway Configuration
# Get your Key ID and Secret from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""
