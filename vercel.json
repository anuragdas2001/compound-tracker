{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/habits",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/habits/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/gamification",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/gamification/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/users",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/users/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/links",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/links/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
